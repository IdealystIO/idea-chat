{
  "name": "idea-chat",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "runServices": ["dev", "postgres", "redis", "chrome"],
  "workspaceFolder": "/workspaces/idea-chat",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080, 9000, 8787, 8788, 8789, 55432, 6399],
  "portsAttributes": {
    "8080": { "label": "web client (idealyst dev)" },
    "9000": { "label": "voice-director" },
    "8787": { "label": "voice-node a" },
    "8788": { "label": "voice-node b" },
    "8789": { "label": "voice-node c" },
    "55432": { "label": "postgres" },
    "6399": { "label": "redis" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}
